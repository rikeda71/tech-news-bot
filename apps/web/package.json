{
  "name": "@tnb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:client": "vp test run --config vitest.client.config.ts",
    "test:watch": "vp test",
    "migrate:local": "wrangler d1 migrations apply tech-news-bot-db --local",
    "migrate:prod": "wrangler d1 migrations apply tech-news-bot-db --remote",
    "cf-typegen": "wrangler types",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.125.0"
  }
}
