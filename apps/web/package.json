{
  "name": "@tnb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:client": "vp test run --config vitest.client.config.ts",
    "test:watch": "vp test",
