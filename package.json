{
  "name": "tech-news-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tnb/web dev",
    "build": "pnpm --filter @tnb/web build",
    "preview": "pnpm --filter @tnb/web preview",
    "deploy": "pnpm --filter @tnb/web deploy",
    "test": "pnpm --filter @tnb/web run test",
    "test:client": "pnpm --filter @tnb/web run test:client",
    "test:watch": "pnpm --filter @tnb/web run test:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "cf-typegen": "pnpm --filter @tnb/web cf-typegen",
    "migrate:local": "pnpm --filter @tnb/web migrate:local",
    "migrate:prod": "pnpm --filter @tnb/web migrate:prod",
    "e2e": "pnpm --filter @tnb/web e2e"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2"
}
